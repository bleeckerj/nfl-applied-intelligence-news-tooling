<section class="page page--inside" data-page-id="{{ page.id }}">
  <header class="masthead masthead--small">
    <div class="masthead__name">{{ page.masthead or title }}</div>
    <div class="masthead__meta">
      <span>{{ issue }}</span>
      <span>{{ date }}</span>
    </div>
  </header>

  <article class="slot slot--opinion">
    {% if page.opinion %}
      <h1 class="headline">{{ page.opinion.headline }}</h1>
      {% if page.opinion.byline %}<p class="byline">{{ page.opinion.byline }}</p>{% endif %}
      <div class="body">
        {% for para in page.opinion.body.split('\n\n') %}
          <p>{{ para }}</p>
        {% endfor %}
      </div>
    {% endif %}
  </article>

  <article class="slot slot--review">
    {% if page.review %}
      <h2 class="section-title">{{ page.review.headline }}</h2>
      {% if page.review.rating %}<p class="meta">Rating: {{ page.review.rating }}</p>{% endif %}
      <div class="body">
        {% for para in page.review.body.split('\n\n') %}
          <p>{{ para }}</p>
        {% endfor %}
      </div>
    {% endif %}
  </article>

  <aside class="slot slot--ad slot--ad-1">
    {% if page.ad_1 %}
      <div class="ad">
        <h2 class="ad__headline">{{ page.ad_1.headline }}</h2>
        <p class="ad__body">{{ page.ad_1.body }}</p>
      </div>
    {% endif %}
  </aside>
</section>
